# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environment
.venv/
venv/
env/

# App data (uploaded files, SQLite, Chroma index)
data/

# Logs
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Test artefacts
.pytest_cache/
.coverage
htmlcov/

# Claude Code local state (ignore all of .claude/ except shared config + slash commands)
.claude/*
!.claude/commands/
!.claude/settings.json

# Local, human-written notes that must never reach this public repo
# (handover notes, sales/internal guides, customer-environment notes).
# The directory's own README is the one committed file — it explains the rule.
local/*
!local/README.md

# Docker compose env (.env.example is committed)
.env

# Local tunable config (config.example.toml is committed)
config.toml
